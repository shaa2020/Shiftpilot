# ShiftPilot environment variables — copy to .env.local for development.
# See ENVIRONMENT.md for the full reference. Never commit real secrets.

# --- Required -------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_ENV=development

# --- Server-only (never expose to the browser) ----------------------------
# Required for invitations to new users, shared rate limiting and background jobs.
SUPABASE_SERVICE_ROLE_KEY=
# Salt for hashing IPs/emails in rate-limit keys. Use a long random value.
IDENTIFIER_HASH_SALT=

# --- Optional integrations (features report "awaiting configuration" when unset)
RESEND_API_KEY=
EMAIL_FROM=
SENTRY_DSN=
# Scheduled jobs: Vercel Cron sends "Authorization: Bearer $CRON_SECRET" (min. 16 chars).
CRON_SECRET=
# Web Push (generate with: npx web-push generate-vapid-keys). Subject: mailto: or https: contact.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=
# WhatsApp Business Cloud API (opt-in per user).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
# Operations assistant (read-only). Data looked up is sent to Anthropic for processing.
ANTHROPIC_API_KEY=
# Require TOTP MFA for agency staff (true/false).
ENFORCE_STAFF_MFA=false
